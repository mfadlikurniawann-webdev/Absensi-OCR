# Salin menjadi .env lalu isi. File .env tidak ikut di-commit.

# ---------- WAJIB diganti sebelum deploy ----------
SECRET_KEY=ganti-dengan-string-acak-panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin

# ---------- Deploy (docker compose) ----------
# Domain untuk HTTPS otomatis (dipakai profile "https")
DOMAIN=absensi.domainanda.com
# 0.0.0.0 = port 5000 terbuka (uji di LAN). Produksi di balik Caddy: 127.0.0.1
API_BIND=0.0.0.0
API_PORT=5000
# Pakai image hasil GitHub Actions alih-alih build di server (opsional):
# API_IMAGE=ghcr.io/mfadlikurniawann-webdev/absensi-ocr/server:latest

# ---------- Opsional (nilai di bawah = default) ----------
APP_TIMEZONE=Asia/Jakarta
# Batas jarak cosine pencocokan wajah; makin kecil makin ketat
MATCH_THRESHOLD=0.40
# Absen ulang dalam rentang menit ini tidak dicatat dobel (0 = nonaktif)
ATTENDANCE_COOLDOWN_MINUTES=5
# true = siapa pun bisa daftar wajah; false = hanya admin
ALLOW_PUBLIC_REGISTER=true
# Masa berlaku login admin di aplikasi mobile (jam)
TOKEN_MAX_AGE_HOURS=12
# Detektor wajah server: opencv (cepat) / retinaface (akurat, berat)
FACE_DETECTOR=opencv
MAX_IMAGE_MB=8
